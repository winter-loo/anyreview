<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"></script><style>@font-face{font-family:Film;src:url('assets/font.otf')}*{box-sizing:border-box}body{margin:0;background:#111320;color:#fff;font-family:Film,sans-serif}#root{width:1920px;height:1080px;position:relative;overflow:hidden}#glow{position:absolute;inset:0;background:radial-gradient(ellipse at 50% 45%,#35315c 0%,#111320 65%)}#phone{position:absolute;left:728px;top:0;width:464px;height:994px;border:2px solid #85848f;border-radius:59px;padding:12px;background:linear-gradient(110deg,#9c9ca7,#272932 20%,#080a11 80%,#7c7e88);box-shadow:0 35px 90px #0009;transform-origin:50% 0%}#screen{position:relative;isolation:isolate;width:436px;height:966px;overflow:hidden;border:6px solid #080a11;border-radius:45px;background:#080a11}.screen-content{position:absolute;inset:0;width:424px;height:954px;object-fit:fill;clip-path:inset(0 round 39px)}#screen-1{object-fit:contain;background:#000}#screen-bezel{position:absolute;left:0;top:0;width:424px;height:954px;z-index:5;pointer-events:none}.brand{position:absolute;left:65px;top:46px;display:flex;align-items:center;gap:14px;font-size:27px;z-index:8}.brand img{width:38px;height:38px}#subtitle{position:absolute;left:0;bottom:0;height:106px;width:1920px;background:linear-gradient(transparent,#111320 35%);display:flex;justify-content:center;align-items:center;font-size:29px;color:#eceaf4;z-index:10}.caption{position:absolute;white-space:nowrap;max-width:1680px;text-align:center}#source-note{position:absolute;right:65px;top:55px;font-size:16px;color:#bbb8ca}.closing{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:32px;opacity:0}.closing img{width:100px;height:100px}.closing h1{font-size:66px;font-weight:500;line-height:1.5;letter-spacing:1px;text-align:center;margin:0}.closing small{font-size:26px;color:#bbb6d4}#agent-return{background:#000}#agent-return>img{width:424px;height:954px;object-fit:contain}.agent-input{position:absolute;left:11px;top:779px;width:401px;height:34px;background:#000;display:flex;align-items:center;gap:9px;font:16px/1.4 Film,monospace;white-space:nowrap}.chevron{font-size:20px}.prompt-char{display:none}.cursor{display:inline-block;width:7px;height:18px;background:#aaa;vertical-align:middle;margin-left:2px}#agent-note{position:absolute;right:65px;top:55px;font-size:16px;color:#bbb8ca;opacity:0}.stack-phone{position:absolute;left:728px;top:0;width:464px;height:994px;border:2px solid #85848f;border-radius:59px;padding:12px;background:linear-gradient(110deg,#9c9ca7,#272932 20%,#080a11 80%,#7c7e88);box-shadow:-20px 25px 70px #0007;transform-origin:50% 0%;opacity:0}.stack-screen{position:relative;width:436px;height:966px;overflow:hidden;border:6px solid #080a11;border-radius:45px;background:#080a11}.stack-screen>img,.stack-screen>video{position:absolute;inset:0;width:424px;height:954px;object-fit:fill;clip-path:inset(0 round 39px)}.stack-screen>svg{position:absolute;inset:0;width:424px;height:954px;z-index:5;pointer-events:none}.screen-transition{position:absolute;inset:0;width:424px;height:954px}#annotation-transition{opacity:0}</style></head><body><div id="root" data-composition-id="main" data-width="1920" data-height="1080" data-duration="93.904000"><div id="glow"></div><div id="phone" data-layout-allow-overflow><div id="screen"><img id="screen-1" class="screen-content clip" src="assets/terminal.png" data-start="0.000000" data-duration="12.726000" data-track-index="0"><img id="screen-2" class="screen-content clip" src="assets/discord.png" data-start="12.726000" data-duration="10.238000" data-track-index="0"><div id="review-entry" class="screen-transition"><img id="screen-3" class="screen-content clip" src="assets/read.png" data-start="22.064000" data-duration="10.156000" data-track-index="0"></div><video id="screen-4" class="screen-content clip" src="assets/reading-v2-volcano.mp4" data-start="32.220000" data-duration="10.416000" data-track-index="0" muted playsinline></video><div id="annotation-transition" class="screen-transition"><img id="annotation-entry-still" class="screen-content clip" src="assets/annotation-entry-v10.png" data-start="41.836000" data-duration="0.300000" data-track-index="1"><video id="screen-5" class="screen-content clip" src="assets/interaction-v2-volcano.mp4" data-start="42.136000" data-duration="13.348000" data-track-index="0" muted playsinline></video></div><video id="screen-6" class="screen-content clip" src="assets/image-volcano.mp4" data-start="55.484000" data-duration="8.548000" data-track-index="0" muted playsinline></video><video id="screen-7" class="screen-content clip" src="assets/submit-volcano.mp4" data-start="64.032000" data-duration="5.571891" data-track-index="0" muted playsinline></video><div id="agent-return" class="screen-content clip" data-start="69.603891" data-duration="6.846109" data-track-index="0"><img src="assets/terminal.png"><div class="agent-input"><span class="chevron">❯</span><span><span class="prompt-char" id="prompt-char-0">用</span><span class="prompt-char" id="prompt-char-1">&nbsp;</span><span class="prompt-char" id="prompt-char-2">r</span><span class="prompt-char" id="prompt-char-3">e</span><span class="prompt-char" id="prompt-char-4">v</span><span class="prompt-char" id="prompt-char-5">i</span><span class="prompt-char" id="prompt-char-6">e</span><span class="prompt-char" id="prompt-char-7">w</span><span class="prompt-char" id="prompt-char-8">&nbsp;</span><span class="prompt-char" id="prompt-char-9">f</span><span class="prompt-char" id="prompt-char-10">e</span><span class="prompt-char" id="prompt-char-11">e</span><span class="prompt-char" id="prompt-char-12">d</span><span class="prompt-char" id="prompt-char-13">b</span><span class="prompt-char" id="prompt-char-14">a</span><span class="prompt-char" id="prompt-char-15">c</span><span class="prompt-char" id="prompt-char-16">k</span><span class="prompt-char" id="prompt-char-17">&nbsp;</span><span class="prompt-char" id="prompt-char-18">获</span><span class="prompt-char" id="prompt-char-19">取</span><span class="prompt-char" id="prompt-char-20">评</span><span class="prompt-char" id="prompt-char-21">论</span><span class="prompt-char" id="prompt-char-22">并</span><span class="prompt-char" id="prompt-char-23">解</span><span class="prompt-char" id="prompt-char-24">决</span><span class="prompt-char" id="prompt-char-25">。</span><b class="cursor"></b></span></div></div><div id="ending-markdown" class="screen-transition"><img id="ending-markdown-media" class="screen-content clip" src="ending/markdown-v10.png" data-start="76.000000" data-duration="11.372000" data-track-index="2"></div><svg id="screen-bezel" viewBox="0 0 424 954" aria-hidden="true" data-layout-ignore><path fill="#080a11" fill-rule="evenodd" d="M0 0H424V954H0Z M39 0H385A39 39 0 0 1 424 39V915A39 39 0 0 1 385 954H39A39 39 0 0 1 0 915V39A39 39 0 0 1 39 0Z"/></svg></div></div><div id="stack-0" class="stack-phone" style="z-index:2" data-layout-allow-overflow><div class="stack-screen"><img id="stack-media-0" class="clip" src="ending/word.png" data-start="78.992000" data-duration="8.380000" data-track-index="30"><svg class="stack-bezel" viewBox="0 0 424 954" aria-hidden="true" data-layout-ignore><path fill="#080a11" fill-rule="evenodd" d="M0 0H424V954H0Z M39 0H385A39 39 0 0 1 424 39V915A39 39 0 0 1 385 954H39A39 39 0 0 1 0 915V39A39 39 0 0 1 39 0Z"/></svg></div></div><div id="stack-1" class="stack-phone" style="z-index:3" data-layout-allow-overflow><div class="stack-screen"><img id="stack-media-1" class="clip" src="ending/excel.png" data-start="79.712000" data-duration="7.660000" data-track-index="31"><svg class="stack-bezel" viewBox="0 0 424 954" aria-hidden="true" data-layout-ignore><path fill="#080a11" fill-rule="evenodd" d="M0 0H424V954H0Z M39 0H385A39 39 0 0 1 424 39V915A39 39 0 0 1 385 954H39A39 39 0 0 1 0 915V39A39 39 0 0 1 39 0Z"/></svg></div></div><div id="stack-2" class="stack-phone" style="z-index:4" data-layout-allow-overflow><div class="stack-screen"><img id="stack-media-2" class="clip" src="ending/ppt.png" data-start="80.872000" data-duration="6.500000" data-track-index="32"><svg class="stack-bezel" viewBox="0 0 424 954" aria-hidden="true" data-layout-ignore><path fill="#080a11" fill-rule="evenodd" d="M0 0H424V954H0Z M39 0H385A39 39 0 0 1 424 39V915A39 39 0 0 1 385 954H39A39 39 0 0 1 0 915V39A39 39 0 0 1 39 0Z"/></svg></div></div><div id="stack-3" class="stack-phone" style="z-index:5" data-layout-allow-overflow><div class="stack-screen"><video id="stack-media-3" class="clip" src="ending/video-stable-v10.mp4" data-start="82.032000" data-duration="5.340000" data-track-index="33" muted playsinline></video><svg class="stack-bezel" viewBox="0 0 424 954" aria-hidden="true" data-layout-ignore><path fill="#080a11" fill-rule="evenodd" d="M0 0H424V954H0Z M39 0H385A39 39 0 0 1 424 39V915A39 39 0 0 1 385 954H39A39 39 0 0 1 0 915V39A39 39 0 0 1 39 0Z"/></svg></div></div><div class="brand"><img src="assets/logo.svg">ReviewLoop</div><div id="source-note">参考界面生成 · 场景演示</div><div id="agent-note">Claude Code · 场景演示</div><div class="closing"><img src="assets/logo.svg"><h1>让 AI 的产出<br>方便查看，直接批注。</h1><small>ReviewLoop</small></div><div id="subtitle"><span id="caption-0" class="caption clip" data-start="0.350000" data-duration="4.560000" data-track-index="20">AI 给出了回复，也生成了文档和图片。</span><span id="caption-1" class="caption clip" data-start="5.250000" data-duration="2.000000" data-track-index="20">可要仔细看看这些结果，</span><span id="caption-2" class="caption clip" data-start="7.650000" data-duration="2.080000" data-track-index="20">有时候，还真不方便。</span><span id="caption-3" class="caption clip" data-start="10.266000" data-duration="2.000000" data-track-index="20">在终端里用 AI，</span><span id="caption-4" class="caption clip" data-start="12.726000" data-duration="2.500000" data-track-index="20">或者在 Discord 里和 Agent 聊天，</span><span id="caption-5" class="caption clip" data-start="15.666000" data-duration="3.000000" data-track-index="20">你想说的，往往不只是“再改一下”，</span><span id="caption-6" class="caption clip" data-start="19.066000" data-duration="2.500000" data-track-index="20">而是——这一段，具体怎么改。</span><span id="caption-7" class="caption clip" data-start="22.414000" data-duration="3.680000" data-track-index="20">ReviewLoop 把 AI 的回复和文件，</span><span id="caption-8" class="caption clip" data-start="26.394000" data-duration="2.140000" data-track-index="20">变成一张独立的审阅网页。</span><span id="caption-9" class="caption clip" data-start="28.774000" data-duration="3.020000" data-track-index="20">打开链接，在手机上就能看。</span><span id="caption-10" class="caption clip" data-start="32.570000" data-duration="2.000000" data-track-index="20">长回复慢慢读，</span><span id="caption-11" class="caption clip" data-start="34.830000" data-duration="3.700000" data-track-index="20">文档里的图片、流程图，也能直接查看。</span><span id="caption-12" class="caption clip" data-start="38.990000" data-duration="2.700000" data-track-index="20">需要看清细节，就点开放大。</span><span id="caption-13" class="caption clip" data-start="42.486000" data-duration="3.340000" data-track-index="20">选中一句话，直接写下意见。</span><span id="caption-14" class="caption clip" data-start="46.206000" data-duration="4.380000" data-track-index="20">比如：“这里，请补充一个具体的使用示例。”</span><span id="caption-15" class="caption clip" data-start="51.186000" data-duration="1.300000" data-track-index="20">不用再复制原文，</span><span id="caption-16" class="caption clip" data-start="52.866000" data-duration="2.100000" data-track-index="20">解释自己说的是哪一段。</span><span id="caption-17" class="caption clip" data-start="55.834000" data-duration="3.700000" data-track-index="20">图片和设计稿，也能圈出具体位置。</span><span id="caption-18" class="caption clip" data-start="59.854000" data-duration="1.960000" data-track-index="20">哪里要改，怎么改，</span><span id="caption-19" class="caption clip" data-start="62.294000" data-duration="1.300000" data-track-index="20">对着内容说清楚。</span><span id="caption-20" class="caption clip" data-start="64.382000" data-duration="2.980000" data-track-index="20">标注完成，提交给 AI。</span><span id="caption-21" class="caption clip" data-start="67.962000" data-duration="3.100000" data-track-index="20">让它读取带着原文和位置的反馈，</span><span id="caption-22" class="caption clip" data-start="71.482000" data-duration="1.300000" data-track-index="20">再继续工作。</span><span id="caption-23" class="caption clip" data-start="72.922000" data-duration="3.060000" data-track-index="20">你审阅结果，AI 执行修改。</span><span id="caption-24" class="caption clip" data-start="76.472000" data-duration="2.350000" data-track-index="20">不只是文字和图片，</span><span id="caption-25" class="caption clip" data-start="78.992000" data-duration="2.700000" data-track-index="20">文档、表格、演示稿，</span><span id="caption-26" class="caption clip" data-start="81.932000" data-duration="2.590000" data-track-index="20">甚至视频，都能这样审阅。</span><span id="caption-27" class="caption clip" data-start="84.812000" data-duration="2.310000" data-track-index="20">更多用法，等你探索。</span><span id="caption-28" class="caption clip" data-start="87.722000" data-duration="3.140000" data-track-index="20">ReviewLoop，让 AI 的产出，</span><span id="caption-29" class="caption clip" data-start="91.302000" data-duration="2.080000" data-track-index="20">方便查看，直接批注。</span></div><audio id="voice-1" src="volcano/voice-1.mp3" data-start="0.350000" data-duration="9.216000" data-track-index="10" data-volume="1"></audio><audio id="voice-2" src="volcano/voice-2.mp3" data-start="10.266000" data-duration="11.448000" data-track-index="10" data-volume="1"></audio><audio id="voice-3" src="volcano/voice-3.mp3" data-start="22.414000" data-duration="9.456000" data-track-index="10" data-volume="1"></audio><audio id="voice-4" src="volcano/voice-4.mp3" data-start="32.570000" data-duration="9.216000" data-track-index="10" data-volume="1"></audio><audio id="voice-5" src="volcano/voice-5.mp3" data-start="42.486000" data-duration="12.648000" data-track-index="10" data-volume="1"></audio><audio id="voice-6" src="volcano/voice-6.mp3" data-start="55.834000" data-duration="7.848000" data-track-index="10" data-volume="1"></audio><audio id="voice-7" src="volcano/voice-7.mp3" data-start="64.382000" data-duration="11.640000" data-track-index="10" data-volume="1"></audio><audio id="voice-8" src="volcano/voice-8.mp3" data-start="87.722000" data-duration="5.832000" data-track-index="10" data-volume="1"></audio><audio id="voice-explore" src="ending/voice-v8.mp3" data-start="76.372000" data-duration="10.416" data-track-index="10" data-volume="1"></audio></div><script>const tl=gsap.timeline({paused:true});
tl.set('#phone',{y:42,scale:1,rotation:-3},0.000000);
// One continuous phone; frame changes represent distinct sources, never slide cards.
tl.to('#phone',{scale:1.25,y:-95,rotation:-1,duration:4.223529,ease:'power2.inOut'},1.132223);
tl.to('#phone',{scale:1,y:42,rotation:2,duration:0.619287,ease:'power2.inOut'},9.296713);
tl.to('#phone',{scale:1.38,y:-150,rotation:0,duration:1.500000,ease:'power2.inOut'},12.726000);
tl.to('#phone',{y:-390,duration:4.249408,ease:'power2.inOut'},14.227703);
tl.to('#phone',{scale:1,y:42,rotation:-3,duration:1.168892,ease:'power2.inOut'},20.895108);
tl.to('#source-note',{opacity:0,duration:0.134547},21.968665);
tl.to('#phone',{scale:1.28,y:-80,rotation:0,duration:2.674366,ease:'power2.inOut'},24.995048);
tl.to('#phone',{scale:1,y:42,duration:1.047781,ease:'power2.inOut'},31.172219);
// Updated diagram UI: click at the narrated action, then real pan.
tl.to('#phone',{scale:1.25,y:-80,rotation:0,duration:1.457202,ease:'power2.inOut'},33.085426);
tl.to('#phone',{scale:1,y:42,duration:1.123383,ease:'power2.inOut'},38.818172);
tl.to('#phone',{scale:1.58,y:-140,rotation:0,duration:2.634162,ease:'power2.inOut'},40.965838);
// Earlier selection, camera arrives before typing at local ~2.9.
// The same camera move settles before selection and composer entry.
tl.to('#phone',{y:-560,duration:1.038139,ease:'power2.inOut'},44.112906);
tl.to('#phone',{scale:1,y:42,duration:1.867008,ease:'power2.inOut'},52.123770);
// Image strokes, composer, then a short readable result hold.
tl.to('#phone',{scale:1.35,y:-65,rotation:0,duration:0.602079,ease:'power2.inOut'},55.484000);
tl.to('#phone',{y:-360,duration:0.804340,ease:'power2.inOut'},58.251611);
tl.to('#phone',{scale:1,y:42,duration:0.584182,ease:'power2.inOut'},63.297261);
// Real submission, then return to the opening Claude Code demo and type the user instruction.
tl.to('#phone',{scale:1.35,y:40,duration:1.259226,ease:'power2.inOut'},64.188848);
tl.to('#phone',{scale:1,y:42,duration:1.241349,ease:'power2.inOut'},68.362542);
tl.to('#phone',{scale:1.65,y:-690,duration:1.055147,ease:'power2.inOut'},69.728026);
tl.to('#agent-note',{opacity:1,duration:0.372405},69.603891);
tl.to('#agent-note',{opacity:0,duration:0.155153},76.081088);
const promptTimes=[70.90730759180073, 71.00040875997354, 71.09350992814633, 71.18661109631914, 71.27971226449193, 71.37281343266474, 71.46591460083755, 71.54741495881382, 71.62649238879735, 71.70556981878087, 71.7846472487644, 71.86372467874793, 71.94280210873146, 72.02187953871498, 72.1009569686985, 72.18003439868203, 72.25911182866555, 72.33818925864908, 72.41726668863261, 72.49634411861614, 72.57542154859966, 72.65449897858319, 72.7335764085667, 72.81265383855023, 72.89173126853376, 72.98132521358369];Array.from(document.querySelectorAll('.prompt-char')).forEach((el,i)=>tl.set(el,{display:'inline'},promptTimes[i]));
tl.to('#phone',{scale:.88,y:95,rotation:-3,duration:.772,ease:'power2.inOut'},75.600000);
tl.to('.closing',{opacity:1,duration:0.683384},87.372000);
tl.to('.brand',{opacity:0,duration:0.313697},87.372000);
tl.set('.brand',{opacity:0},87.728070);
tl.set('#source-note',{opacity:0},22.064000);tl.set('#stack-0',{x:360,y:125,scale:.91,rotation:5},0);
tl.to('#stack-0',{x:180,y:200,scale:.78,rotation:0,opacity:1,duration:0.6699999999999997,ease:'power3.out'},78.992000);
tl.to('#phone',{x:35,y:156,scale:0.762,rotation:-0.5,duration:0.6699999999999997,ease:'power3.inOut'},78.992000);
tl.set('#stack-1',{x:360,y:125,scale:.91,rotation:5},0);
tl.to('#stack-1',{x:180,y:200,scale:.78,rotation:0,opacity:1,duration:0.9,ease:'power3.out'},79.712000);
tl.to('#phone',{x:-110,y:112,scale:0.744,rotation:-1.0,duration:0.9,ease:'power3.inOut'},79.712000);
tl.to('#stack-0',{x:35,y:156,scale:0.762,rotation:-0.5,duration:0.9,ease:'power3.inOut'},79.712000);
tl.set('#stack-2',{x:360,y:125,scale:.91,rotation:5},0);
tl.to('#stack-2',{x:180,y:200,scale:.78,rotation:0,opacity:1,duration:0.9,ease:'power3.out'},80.872000);
tl.to('#phone',{x:-255,y:68,scale:0.726,rotation:-1.5,duration:0.9,ease:'power3.inOut'},80.872000);
tl.to('#stack-0',{x:-110,y:112,scale:0.744,rotation:-1.0,duration:0.9,ease:'power3.inOut'},80.872000);
tl.to('#stack-1',{x:35,y:156,scale:0.762,rotation:-0.5,duration:0.9,ease:'power3.inOut'},80.872000);
tl.set('#stack-3',{x:360,y:125,scale:.91,rotation:5},0);
tl.to('#stack-3',{x:180,y:200,scale:.78,rotation:0,opacity:1,duration:0.9,ease:'power3.out'},82.032000);
tl.to('#phone',{x:-400,y:24,scale:0.7080000000000001,rotation:-2.0,duration:0.9,ease:'power3.inOut'},82.032000);
tl.to('#stack-0',{x:-255,y:68,scale:0.726,rotation:-1.5,duration:0.9,ease:'power3.inOut'},82.032000);
tl.to('#stack-1',{x:-110,y:112,scale:0.744,rotation:-1.0,duration:0.9,ease:'power3.inOut'},82.032000);
tl.to('#stack-2',{x:35,y:156,scale:0.762,rotation:-0.5,duration:0.9,ease:'power3.inOut'},82.032000);
tl.to('#phone',{opacity:0,duration:.45},86.922000);tl.set('#phone',{opacity:0},87.372000);
tl.to('#stack-0',{opacity:0,duration:.45},86.922000);tl.set('#stack-0',{opacity:0},87.372000);
tl.to('#stack-1',{opacity:0,duration:.45},86.922000);tl.set('#stack-1',{opacity:0},87.372000);
tl.to('#stack-2',{opacity:0,duration:.45},86.922000);tl.set('#stack-2',{opacity:0},87.372000);
tl.to('#stack-3',{opacity:0,duration:.45},86.922000);tl.set('#stack-3',{opacity:0},87.372000);

tl.set('#review-entry',{x:424},0);
tl.to('#review-entry',{x:0,duration:.85,ease:'power3.inOut'},22.064);
tl.to('#screen-2',{x:-90,duration:.85,ease:'power3.inOut'},22.064);
tl.to('#annotation-transition',{opacity:1,duration:.8,ease:'power2.inOut'},41.836);
tl.set('#ending-markdown',{x:424},0);
tl.to('#ending-markdown',{x:0,duration:.45,ease:'power3.inOut'},76);
window.__timelines=window.__timelines||{};window.__timelines.main=tl;</script></body></html>